@model List<MyApp1.Models.Items>
@Html.AntiForgeryToken()

@{
    // di solito qui si specifica il titolo della pagina, "Title" è una key
    ViewData["Title"] = "Index";
}



<style>
    main{
        position: relative;
        width: auto;
        height: 100vh;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
    }

    .table{
        padding: 0 20px;
        border-radius: 10px;
        box-shadow: 10px 10px 15px rgba(0, 0, 0, 0.2);
    }
    

    .main-it-div{
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background: rgba(255, 255, 255, 0.8);
        border-radius: 10px;
        box-shadow: 10px 10px 15px rgba(0, 0, 0, 0.2);
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .main-it-div > .table {
        margin-bottom: 0;
    }

    tr{
        margin: 15px 0;
    }

    #n-it-found{
        color: rgba(0, 0, 0, 0.7);
    }
</style>

<img id="img-sfondo" src="~/src/pexels-tiger-lily-4483773.jpg" alt="Background" />

<div class="container-fluid mt-4">
    <div class="table-responsive main-it-div">
        <table class="table">
            <thead>
                <th>Name</th>
                <th>Price</th>
                <th>Serial Number</th>
                <th>Category</th>
                <th>Modify</th>
            </thead>
                
                <tbody class="table-hover tbody">
                    @if (Model.Count != 0){
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!--td sta per table data-->
                                    <td>@item.Name</td>
                                    <td>@item.Price.ToString("N2") $</td>
                                    <!--funziona grazie a Include(s => s.SerNumber) in ItemsController, buona pratica-->
                                    <td>@item.SerNumber?.Name</td>  <!--aggiunta del punto di domanda perchè può essere null-->
                                    <th>@item.Category?.Name</th>
                                    <td>
                                        <!--asp-action è un helper (permette di sviluppare task), questo in particolare permetterà di dirigere il link all'action edit-->
                                        <!--ridirige alla pagina edit con l'id specificato in asp-route-id -->
                                        <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                        <!--stessa funzione di prima ma verso l'action delete-->
                                        <button class="btn btn-secondary" onclick="delItem(@item.Id, this)">Delete</button>
                                    </td>
                                </tr>
                            }
                    }
                </tbody>
             
        </table>
        
        <h2 id="n-it-found" class="w-100 text-center noItems" style="display: none"> No items found!</h2>
    </div>

    <div class="modal fade" id="delete-modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure to delete this item?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Close
                    </button>
                    <button type="button" class="btn btn-danger" id="buttonDelete" data-bs-dismiss="modal">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>



<a asp-action="Create" class="btn btn-primary mt-4">New Item</a>



@section Scripts{
    <script src="~/js/ElencoItems.js"></script>
}